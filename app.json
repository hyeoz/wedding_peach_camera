{
  "expo": {
    "name": "웨피캠",
    "slug": "wepicam",
    "owner": "hyeoz",
    "version": "1.0.0",
    "icon": "./assets/icon-candidate-shoujo.png",
    "orientation": "portrait",
    "scheme": "wepicam",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyeoz.wepicam",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "웨피캠",
        "NSCameraUsageDescription": "사진을 촬영하기 위해 카메라에 접근합니다.",
        "NSPhotoLibraryUsageDescription": "꾸밀 사진과 직접 등록할 프레임·스티커 이미지를 불러오기 위해 사진에 접근합니다.",
        "NSPhotoLibraryAddUsageDescription": "완성한 사진을 기기에 저장하기 위해 사진에 접근합니다."
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-shoujo.png",
          "enableFullScreenImage_legacy": true,
          "resizeMode": "cover",
          "backgroundColor": "#2b075d",
          "dark": {
            "image": "./assets/splash-shoujo.png",
            "backgroundColor": "#2b075d"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "꾸밀 사진과 직접 등록할 프레임·스티커 이미지를 불러오기 위해 사진에 접근합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "완성한 사진을 기기에 저장하기 위해 사진에 접근합니다.",
          "savePhotosPermission": "완성한 사진을 기기에 저장하기 위해 사진에 접근합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "addf138b-49c9-4309-8d96-995b707bda2f"
      }
    }
  }
}
