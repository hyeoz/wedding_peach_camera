{
  "expo": {
    "name": "Wedding Peach Camera",
    "slug": "wedding-peach-camera",
    "version": "0.1.0",
    "icon": "./assets/icon-candidate-shoujo.png",
    "orientation": "portrait",
    "scheme": "weddingpeachcamera",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-shoujo.png",
      "resizeMode": "cover",
      "backgroundColor": "#2b075d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weddingpeach.camera",
      "infoPlist": {
        "NSCameraUsageDescription": "사진 촬영을 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "프레임·스티커·사진을 불러오기 위해 사진 접근이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "완성된 결과물을 저장하기 위해 사진 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.weddingpeach.camera",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-candidate-shoujo.png",
        "backgroundColor": "#2b075d"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-shoujo.png",
          "resizeMode": "cover",
          "backgroundColor": "#2b075d"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "사진 촬영을 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프레임·스티커·사진을 불러오기 위해 사진 접근이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "완성된 결과물을 저장하기 위해 사진 접근이 필요합니다.",
          "savePhotosPermission": "완성된 결과물을 저장하기 위해 사진 접근이 필요합니다.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
