{
  "name": "wepicam",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "doctor": "npx expo-doctor",
    "deploy:check": "node scripts/assert-eas-owner.mjs",
    "build:ios:store": "npx --yes eas-cli@22.0.0 build --platform ios --profile production",
    "submit:ios": "npx --yes eas-cli@22.0.0 submit --platform ios --profile production",
    "release:check": "node scripts/release.mjs --dry-run",
    "release:ios": "node scripts/release.mjs",
    "release:ios:review": "node scripts/release.mjs --submit-for-review"
  },
  "dependencies": {
    "@expo-google-fonts/gaegu": "^0.4.1",
    "@expo-google-fonts/jua": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.4.2",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  },
  "private": true
}
