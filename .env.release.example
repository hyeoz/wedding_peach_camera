# 복사해서 .env.release 로 쓰고 실제 값을 채운다. .env.release 는 커밋되지 않는다.
# App Store Connect > 사용자 및 액세스 > 통합 > App Store Connect API 에서 키 생성 (역할: App Manager)
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/Users/hyewonlee/.appstore/AuthKey_XXXXXXXXXX.p8
# ASC_APP_ID 는 생략 가능 — eas.json 의 submit.production.ios.ascAppId 를 자동으로 사용한다
