{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "device": {
      "//": "실기기에 설치하는 개발 빌드. simulator 빌드는 실기기에 설치할 수 없어 프로필을 분리한다.",
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "//": "TestFlight 전, 테스터에게 배포해 보는 릴리스 구성 빌드.",
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6802001222",
        "appName": "웨피캠",
        "language": "ko-KR",
        "sku": "wepicam-ios",
        "bundleIdentifier": "com.hyeoz.wepicam",
        "appleTeamId": "25KGF8Y83H"
      }
    }
  }
}
